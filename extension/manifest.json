{
  "manifest_version": 3,
  "name": "Shelfに保存",
  "version": "1.1.1",
  "description": "今開いているページを Figma Plugin Shelf に保存します",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shelfに保存",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Shelfに保存を開く"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}